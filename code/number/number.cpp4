#include <iostream>
#include <fstream>

using namespace std;

int main(){
	ifstream fin("number.in");
	ofstream fout("number.out");

	// 01010100
	// 01234567
	string str; // 基本数据类型
	fin>>str;
	int count = 0;
	for(int i = 0; i < str.length();i++){	
		if(str[i] == '1'){
			count += 1;		
		} 
	}
	fout<<count;
	return 0;
}
